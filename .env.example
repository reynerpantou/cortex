# Copy to .env and adjust. All values are optional; these are the defaults.
CORTEX_ADDR=:8080
# Postgres connection string. This default matches `docker compose up` (or
# `make db` to run just the postgres service for local `go run`/dev-api use).
CORTEX_DATABASE_URL=postgres://cortex:cortex@localhost:5432/cortex?sslmode=disable
CORTEX_COOKIE_SECURE=false
CORTEX_SESSION_TTL_HOURS=168
CORTEX_ADMIN_USER=admin
# Leave empty to have a password generated + printed once on first run.
CORTEX_ADMIN_PASSWORD=
# AI layer (next slice). Empty = AI disabled.
ANTHROPIC_API_KEY=
