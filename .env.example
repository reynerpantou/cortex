# Copy to .env and adjust. `docker compose` auto-loads this file.
CORTEX_ADDR=:8080
# Postgres connection string for running the binary outside Docker
# (`make dev-api` / `make run`). Keep the password in sync with
# POSTGRES_PASSWORD below.
CORTEX_DATABASE_URL=postgres://cortex:CHANGE-ME@localhost:5432/cortex?sslmode=disable
# Credentials docker compose creates the Postgres container with. Required —
# compose refuses to start without a password. Use a long random one, e.g.
#   openssl rand -hex 24
POSTGRES_USER=cortex
POSTGRES_PASSWORD=
POSTGRES_DB=cortex
# Cookies are Secure (HTTPS-only) by default. Browsers still accept them on
# http://localhost; set false only to test from another machine over plain HTTP.
CORTEX_COOKIE_SECURE=true
CORTEX_SESSION_TTL_HOURS=168
# IPs/CIDRs of the reverse proxy in front of Cortex. X-Forwarded-For is only
# believed from these; empty = use the direct connection's address.
CORTEX_TRUSTED_PROXIES=
# Where people open Cortex. Google and Apple return people to
# <CORTEX_PUBLIC_URL>/api/auth/<google|apple>/callback — register exactly that.
CORTEX_PUBLIC_URL=http://localhost:8080
# The owner account, created on first run, and the Google/Apple email that
# signs in as it (set once if the owner has no email yet).
CORTEX_ADMIN_USER=admin
CORTEX_ADMIN_EMAIL=
# Sign in with Google (Google Cloud console → OAuth client, type "Web").
CORTEX_GOOGLE_CLIENT_ID=
CORTEX_GOOGLE_CLIENT_SECRET=
# Sign in with Apple (Apple Developer account). CLIENT_ID is the Services ID.
# PRIVATE_KEY is the .p8 file's contents: either the whole file, or just the
# lines between BEGIN and END joined into one line.
CORTEX_APPLE_CLIENT_ID=
CORTEX_APPLE_TEAM_ID=
CORTEX_APPLE_KEY_ID=
CORTEX_APPLE_PRIVATE_KEY=
# AI layer (next slice). Empty = AI disabled.
ANTHROPIC_API_KEY=
